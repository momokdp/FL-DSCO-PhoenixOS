# =====================================================================
# Copiez ce fichier en « .env » à la racine, puis renseignez les valeurs.
# Le fichier .env ne doit jamais être versionné ni partagé.
# =====================================================================

# --- Réseau ----------------------------------------------------------
PORT=3000

# Interface d'écoute. 127.0.0.1 signifie « accessible seulement depuis la
# machine » : le proxy inverse (nginx, IIS) y accède, mais le port n'est pas
# exposé sur Internet. Ne passez à 0.0.0.0 que si vous servez sans proxy.
HOST=127.0.0.1

# URL publique exacte, sans barre oblique finale.
# Elle sert à construire l'adresse de retour Discord : toute différence
# (http au lieu de https, port manquant) fait échouer la connexion.
BASE_URL=https://logistique.exemple.fr

# --- Session ---------------------------------------------------------
# Chaîne aléatoire longue. Générez-la avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# La changer déconnecte tout le monde.
SESSION_SECRET=

# --- Discord ---------------------------------------------------------
# https://discord.com/developers/applications → votre application
# Onglet OAuth2 : ajoutez comme URL de redirection, à l'identique :
#   <BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facultatif : n'autoriser que les membres de ce serveur Discord.
# Laisser vide pour accepter tout compte Discord.
DISCORD_GUILD_ID=

# Identifiants Discord promus administrateurs à leur connexion.
# Indispensable au premier démarrage, sinon personne ne peut rien gérer.
# Séparez par des virgules. Pour obtenir le vôtre : Discord → Paramètres →
# Avancés → Mode développeur, puis clic droit sur votre nom → Copier l'ID.
BOOTSTRAP_ADMIN_IDS=

# --- Synchronisation darkstat ---------------------------------------
DARKSTAT_URL=https://darkstat.dd84ai.com
SYNC_INTERVAL_MINUTES=10

# Analyse des routes commerciales. Les prix de marché bougent lentement :
# une passe par heure suffit et épargne deux appels d'API à chaque relevé.
ROUTES_INTERVAL_MINUTES=60
SYNC_TIMEOUT_MS=20000

# --- Boucles de trade -----------------------------------------------
# Les circuits sont recalculés dans la même passe que les routes : ils
# lisent le même marché, à la même cadence.
#
# Cale servant à classer les circuits au moment du calcul. Le pilote
# déclare la sienne dans l'écran « Boucles » et les chiffres sont refaits
# à sa mesure ; cette valeur ne sert qu'à retenir les meilleurs candidats.
LOOPS_REF_CARGO=5000

# Offres retenues par mission avant de compter le temps de trajet. La base
# la moins chère n'est pas la meilleure une fois la distance comptée.
LOOPS_OFFERS_PER_MISSION=5

# Segments gardés de chaque bord avant d'éprouver les retours. Mesurer
# tous les retours coûterait le carré du nombre de candidats.
LOOPS_LEGS_PER_SIDE=8

# Circuits gardés par station. Au-delà, l'écran devient un catalogue.
LOOPS_PER_STATION=12

# /api/graph/paths accepte un tableau de couples : 400 partent en un appel.
PATHS_BATCH_SIZE=400

# La carte du jeu ne bouge pas : les temps mesurés sont mis en cache. On
# les réinterroge au bout d'un mois, au cas où un passage serait ouvert.
PATHS_MAX_AGE_DAYS=30

# --- Recettes Discovery ---------------------------------------------
RECIPE_SOURCE_URL=https://discoverygc.com/gameconfigpublic/base_recipe_items.cfg

# --- Stockage --------------------------------------------------------
# Chemin du fichier SQLite. Par défaut : <projet>/data/kadesh.sqlite
# Linux   : DB_FILE=/opt/kadesh/data/kadesh.sqlite
# Windows : DB_FILE=D:\kadesh\data\kadesh.sqlite
